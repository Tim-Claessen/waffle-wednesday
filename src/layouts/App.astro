---
/**
 * The signed-in shell: a top bar, the page, and a three-tab dock in the thumb zone.
 *
 * Three tabs is the whole navigation. Posting has to feel like almost nothing, so the
 * recorder is one tap from anywhere in the app rather than a screen you navigate to.
 *
 * `fill` pins the shell to the screen height so the page can lay itself out without
 * scrolling — the recorder uses it so the shutter is never under the dock.
 */
import Base from './Base.astro';
import GroupSwitcher from '../components/GroupSwitcher.astro';
import Icon from '../components/Icon.astro';
import type { GroupSummary } from '../lib/db.ts';

interface Props {
  title: string;
  groups: GroupSummary[];
  group: GroupSummary;
  /** Which dock tab reads as current. */
  tab: 'week' | 'record' | 'archive' | 'settings';
  fill?: boolean;
}

const { title, groups, group, tab, fill = false } = Astro.props;

const tabs = [
  { id: 'week', label: 'This week', href: `/g/${group.slug}`, icon: 'home' },
  { id: 'record', label: 'Record', href: `/g/${group.slug}/record`, icon: 'record' },
  { id: 'archive', label: 'My waffles', href: '/archive', icon: 'archive' },
] as const;
---

<Base bodyClass={fill ? 'h-dvh overflow-hidden' : 'min-h-dvh'} title={title}>
  <div
    class:list={[
      'mx-auto flex max-w-lg flex-col bg-surface-container-lowest',
      fill ? 'h-dvh' : 'min-h-dvh',
    ]}
  >
    <header class="sticky top-0 z-40 border-b border-outline-variant/30 bg-surface pt-[env(safe-area-inset-top)]">
      <div class="flex items-center justify-between gap-space-sm px-margin-sm py-space-sm">
        <GroupSwitcher current={group} groups={groups} />
        <a
          aria-current={tab === 'settings' ? 'page' : undefined}
          aria-label="Settings"
          class:list={[
            'flex h-9 w-9 shrink-0 items-center justify-center rounded-full transition-colors hover:text-primary',
            tab === 'settings' ? 'text-primary' : 'text-on-surface-variant',
          ]}
          data-dock
          href={`/g/${group.slug}/settings`}
        >
          <Icon name="settings" size={20} />
        </a>
      </div>
    </header>

    <main
      class:list={[
        'flex-1 px-margin-sm',
        fill ? 'flex min-h-0 flex-col py-space-sm' : 'pb-space-xl pt-space-md',
      ]}
    >
      <slot />
    </main>

    <!-- The dock sits above the iOS home indicator rather than under it. -->
    <nav
      class="sticky bottom-0 z-40 border-t border-outline-variant/30 bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur"
    >
      <ul class="flex items-stretch">
        {
          tabs.map((item) => (
            <li class="flex-1">
              <a
                aria-current={item.id === tab ? 'page' : undefined}
                class:list={[
                  'flex flex-col items-center gap-1 py-space-sm text-label-sm transition-colors',
                  item.id === tab ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface',
                ]}
                data-dock
                href={item.href}
              >
                <Icon filled={item.id === tab} name={item.icon} size={22} />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<style is:global>
  /* While an upload is in flight the dock and header links stop working, so a stray tap
     can't leave the page. The recorder sets this. */
  body[data-busy] [data-dock] {
    pointer-events: none;
    opacity: 0.35;
  }
</style>
