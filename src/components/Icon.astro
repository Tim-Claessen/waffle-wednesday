---
/**
 * The icon set, inline.
 *
 * Drawn as SVG paths rather than loaded from an icon font: a font is a third-party
 * request and a flash of missing glyphs, for eleven shapes we can carry ourselves.
 */
interface Props {
  name: keyof typeof PATHS;
  /** Pixel size. The dock uses 24, a card badge 16, the record button 32. */
  size?: number;
  filled?: boolean;
  class?: string;
}

const PATHS = {
  play: '<path d="M8 5.2v13.6a1 1 0 0 0 1.53.85l10.3-6.8a1 1 0 0 0 0-1.7L9.53 4.35A1 1 0 0 0 8 5.2z"/>',
  pause: '<path d="M8 5h3v14H8zM13 5h3v14h-3z"/>',
  home: '<path d="M3.5 10.6 12 3.8l8.5 6.8V20a1 1 0 0 1-1 1h-5.2v-6.2H9.7V21H4.5a1 1 0 0 1-1-1z"/>',
  record:
    '<path d="M15 8.5V7a1.5 1.5 0 0 0-1.5-1.5h-9A1.5 1.5 0 0 0 3 7v10a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 15 17v-1.5l5.2 3a.8.8 0 0 0 1.3-.7V6.2a.8.8 0 0 0-1.3-.7z"/>',
  archive:
    '<path d="M5 3h13a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v14h12V5zm2 3h8M7 11h8M7 14h5"/>',
  chevronDown: '<path d="m6 9.5 6 6 6-6"/>',
  chevronLeft: '<path d="m15 18.5-6-6.5 6-6.5"/>',
  chevronUp: '<path d="m6 14.5 6-6 6 6"/>',
  close: '<path d="M18.5 5.5 5.5 18.5M5.5 5.5l13 13"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  eye: '<path d="M2 12s3.7-6.5 10-6.5S22 12 22 12s-3.7 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/>',
  retake: '<path d="M20.5 12a8.5 8.5 0 1 1-2.5-6M20.5 3.5v5h-5"/>',
  trash: '<path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 10.5v6M14 10.5v6"/>',
  upload: '<path d="M12 16.5V4.5m0 0 4.5 4.5M12 4.5 7.5 9M4 19.5h16"/>',
  mail: '<path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6 8.5-6"/>',
  sound: '<path d="M4 9.5h3l4.5-4v13L7 14.5H4zM16 9a4 4 0 0 1 0 6M18.8 6.5a7.5 7.5 0 0 1 0 11"/>',
  muted: '<path d="M4 9.5h3l4.5-4v13L7 14.5H4zM16.5 9.5l5 5M21.5 9.5l-5 5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  settings:
    '<circle cx="12" cy="12" r="3"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/><circle cx="12" cy="12" r="6.8"/>',
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="1.5"/><path d="M15.5 8.5V6A1.5 1.5 0 0 0 14 4.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5"/>',
} as const;

const { name, size = 24, filled = false, class: className = '' } = Astro.props;
---

<svg
  aria-hidden="true"
  class={className}
  fill={filled ? 'currentColor' : 'none'}
  height={size}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.6"
  viewBox="0 0 24 24"
  width={size}
  set:html={PATHS[name]}
/>
