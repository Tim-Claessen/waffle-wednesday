---
/**
 * One waffle in the week's feed: a short row with a portrait thumbnail, so a full table
 * of nine still fits on a couple of screens.
 *
 * Shows whose it is, how long it runs, whether you've watched it, and the caption if
 * there is one. It never shows a play count, a "new" badge in red, or anything that
 * implies urgency: the video is the content and the card is a door to it.
 */
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import { REACTION_GLYPHS } from '../lib/database.types.ts';
import type { FeedWaffle } from '../lib/db.ts';
import { formatDuration } from '../lib/week.ts';

interface Props {
  waffle: FeedWaffle;
  /** The rest of the week's feed, so the player can move to the next person. */
  playlist: string[];
  groupSlug: string;
}

const { waffle, playlist, groupSlug } = Astro.props;

const href = `/g/${groupSlug}/watch/${waffle.id}?from=${playlist.join(',')}`;
---

<a
  class:list={[
    'group flex items-center gap-space-sm overflow-hidden rounded-xl bg-surface-container-low p-space-xs pr-space-md transition-colors',
    !waffle.watched && !waffle.isMine ? 'ghost-border-active' : 'ghost-border',
  ]}
  href={href}
>
  <span class="sunken-well relative block h-24 w-18 shrink-0 overflow-hidden rounded-lg bg-surface-container-lowest">
    {
      waffle.thumbnailPath ? (
        <img
          alt=""
          class="h-full w-full object-cover"
          height="96"
          loading="lazy"
          src={waffle.thumbnailPath}
          width="72"
        />
      ) : (
        <span class="flex h-full w-full items-center justify-center">
          <Monogram initials={waffle.initials} size="sm" />
        </span>
      )
    }
    <span
      class="absolute bottom-1 right-1 rounded-full bg-surface-container-lowest/85 px-1.5 text-label-sm text-on-surface"
    >
      {formatDuration(waffle.durationSeconds)}
    </span>
  </span>

  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-1.5">
      <span class="truncate font-serif text-headline-sm text-on-surface">
        {waffle.isMine ? 'Yours' : waffle.displayName}
      </span>
      {waffle.watched && !waffle.isMine && <Icon class="shrink-0 text-outline" name="check" size={14} />}
    </span>
    {waffle.caption && (
      <span class="mt-0.5 block line-clamp-2 text-body-sm text-on-surface-variant">{waffle.caption}</span>
    )}
    <span class="mt-0.5 flex items-center gap-space-sm text-label-sm text-outline">
      {
        /*
          Only ever on your own waffle, and only ever a count. Naming who hasn't watched
          is the thing this app exists not to do, so there is no branch here that could.
        */
        waffle.isMine && waffle.watchedByCount > 0 && (
          <span class="flex items-center gap-1">
            <Icon name="eye" size={13} />
            {waffle.watchedByCount}
          </span>
        )
      }
      {waffle.reactions
        .filter((tally) => tally.count > 0)
        .map((tally) => (
          <span aria-hidden="true" class="text-[14px]">{REACTION_GLYPHS[tally.emoji].glyph}</span>
        ))}
    </span>
  </span>

  <Icon class="shrink-0 text-primary" filled name="play" size={20} />
</a>
