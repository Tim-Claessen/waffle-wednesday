---
/**
 * Group settings. Every member gets the page; admins get most of it.
 *
 * Everyone: who's in the group, leaving it, their password, signing out.
 * Admins, as well: the name, the reminders, the invite link, and who else is an admin.
 *
 * Reminder times and recipients live in the database rather than in the code, so
 * widening reminders to everyone is a form submission rather than a deploy.
 *
 * The invite link is shown once, when it is made, because only its hash is stored.
 * Making a new one kills the old — that is also how a leaked link is revoked.
 *
 * Leaving and removal end a membership, never an account or a waffle: nothing is
 * deleted by the system. The last admin can't leave or be demoted while anyone else is
 * still in the group, so a group can never be left without somebody to run it.
 */
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import Monogram from '../../../components/Monogram.astro';
import { initialsFor } from '../../../lib/auth.ts';
import { absoluteUrl } from '../../../lib/config.ts';
import { listGroups, loadMembers } from '../../../lib/db.ts';
import { MEMBER_CAP, generateInviteToken, hashInviteToken } from '../../../lib/invites.ts';

const { supabase, user } = Astro.locals;
const { slug } = Astro.params;

const groups = await listGroups(supabase, user!.id);
const group = groups.find((candidate) => candidate.slug === slug);
if (!group) return Astro.redirect('/', 302);
const isAdmin = group.role === 'admin';

let saved = false;
let problem: string | null = null;
/** Only ever set on the response that created it. */
let freshInviteUrl: string | null = null;

const before = await loadMembers(supabase, group.id);
const adminCount = before.filter((member) => member.role === 'admin').length;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const memberId = String(form.get('member') ?? '');
  const target = before.find((member) => member.id === memberId);

  if (intent === 'leave') {
    if (isAdmin && adminCount === 1 && before.length > 1) {
      problem = 'Make someone else an admin first.';
    } else {
      const { error } = await supabase
        .from('memberships')
        .delete()
        .eq('group_id', group.id)
        .eq('profile_id', user!.id);
      if (!error) return Astro.redirect('/', 303);
      problem = error.message;
    }
  } else if (!isAdmin) {
    problem = 'Only admins can change that.';
  } else if (intent === 'group') {
    const name = String(form.get('name') ?? '').trim();
    if (name.length === 0) {
      problem = 'The group needs a name.';
    } else {
      const { error } = await supabase
        .from('groups')
        .update({
          name,
          morning_reminder_at: String(form.get('morning_reminder_at') ?? ''),
          evening_reminder_at: String(form.get('evening_reminder_at') ?? ''),
          reminder_recipients: form.get('reminder_recipients') === 'everyone' ? 'everyone' : 'admins',
          reminders_enabled: form.get('reminders_enabled') === 'on',
        })
        .eq('id', group.id);
      if (error) problem = error.message;
      else saved = true;
    }
  } else if (intent === 'invite-new') {
    const token = generateInviteToken();
    const { error } = await supabase
      .from('groups')
      .update({ invite_token_hash: await hashInviteToken(token), invite_created_at: new Date().toISOString() })
      .eq('id', group.id);
    if (error) problem = error.message;
    else freshInviteUrl = absoluteUrl(`/join/${token}`);
  } else if (intent === 'invite-off') {
    const { error } = await supabase
      .from('groups')
      .update({ invite_token_hash: null, invite_created_at: null })
      .eq('id', group.id);
    if (error) problem = error.message;
  } else if (target && (intent === 'promote' || intent === 'demote')) {
    if (intent === 'demote' && target.role === 'admin' && adminCount === 1) {
      problem = 'A group needs at least one admin.';
    } else {
      const { error } = await supabase
        .from('memberships')
        .update({ role: intent === 'promote' ? 'admin' : 'member' })
        .eq('group_id', group.id)
        .eq('profile_id', target.id);
      if (error) problem = error.message;
    }
  } else if (target && intent === 'remove' && target.id !== user!.id) {
    const { error } = await supabase
      .from('memberships')
      .delete()
      .eq('group_id', group.id)
      .eq('profile_id', target.id);
    if (error) problem = error.message;
  }
}

// Re-read so the page shows what was actually stored rather than what was submitted.
const current = (await listGroups(supabase, user!.id)).find((g) => g.id === group.id) ?? group;
const members = await loadMembers(supabase, group.id);
const { data: inviteRow } = await supabase
  .from('groups')
  .select('invite_created_at')
  .eq('id', group.id)
  .maybeSingle();
const hasLiveInvite = Boolean(inviteRow?.invite_created_at);
const full = members.length >= MEMBER_CAP;

const field =
  'mt-space-xs w-full rounded-lg bg-surface-container px-space-sm py-space-sm text-body-md text-on-surface ghost-border focus:outline-none';
const heading = 'text-label-md uppercase tracking-wider text-tertiary';
const quiet = 'text-label-sm text-outline transition-colors hover:text-primary';
---

<App group={current} groups={groups} tab="settings" title="Settings">
  <h1 class="font-serif text-headline text-on-surface">Settings</h1>

  {saved && (
    <p class="mt-space-md text-body-sm text-secondary" role="status">Saved.</p>
  )}
  {problem && (
    <p
      class="mt-space-md rounded-lg border border-error/40 bg-error-container/20 p-space-sm text-body-sm text-on-error-container"
      role="alert"
    >
      {problem}
    </p>
  )}

  {
    isAdmin && (
      <section class="mt-space-lg">
        <h2 class={heading}>Invite</h2>
        {freshInviteUrl ? (
          <div class="mt-space-sm space-y-space-sm">
            <input class={field} id="invite-url" readonly type="text" value={freshInviteUrl} />
            <div class="flex gap-space-sm">
              <button
                class="flex flex-1 items-center justify-center gap-2 rounded-lg bg-primary px-space-md py-space-sm text-label-md text-on-primary"
                data-share
                type="button"
              >
                <Icon name="copy" size={16} />
                <span data-share-label>Copy link</span>
              </button>
            </div>
            <p class="text-label-sm text-outline">Shown once. Making a new one stops this one working.</p>
          </div>
        ) : (
          <form class="mt-space-sm flex items-center gap-space-md" method="post">
            <button
              class="rounded-lg bg-primary px-space-md py-space-sm text-label-md text-on-primary disabled:opacity-50"
              disabled={full}
              name="intent"
              type="submit"
              value="invite-new"
            >
              {hasLiveInvite ? 'New link' : 'Make a link'}
            </button>
            {hasLiveInvite && (
              <button class={quiet} name="intent" type="submit" value="invite-off">
                Turn off
              </button>
            )}
            {full && <span class="text-label-sm text-outline">Full at {MEMBER_CAP}</span>}
          </form>
        )}
      </section>
    )
  }

  <section class="mt-space-lg">
    <h2 class={heading}>Members · {members.length}</h2>
    <ul class="mt-space-sm space-y-space-xs">
      {
        members.map((member) => (
          <li class="ghost-border rounded-lg bg-surface-container-low">
            <details class="group">
              <summary
                class:list={[
                  'flex list-none items-center gap-space-sm p-space-sm',
                  isAdmin && member.id !== user!.id ? 'cursor-pointer' : 'pointer-events-none',
                ]}
              >
                <Monogram initials={initialsFor(member.displayName)} size="sm" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-body-md text-on-surface">
                    {member.displayName}
                    {member.id === user!.id && <span class="text-outline"> · you</span>}
                  </span>
                  {isAdmin && <span class="block truncate text-label-sm text-outline">{member.email}</span>}
                </span>
                {member.role === 'admin' && (
                  <span class="shrink-0 rounded-full bg-surface-container-high px-2 py-0.5 text-label-sm text-on-surface-variant">
                    Admin
                  </span>
                )}
              </summary>
              {isAdmin && member.id !== user!.id && (
                <form class="flex gap-space-md px-space-sm pb-space-sm" method="post">
                  <input name="member" type="hidden" value={member.id} />
                  <button
                    class={quiet}
                    name="intent"
                    type="submit"
                    value={member.role === 'admin' ? 'demote' : 'promote'}
                  >
                    {member.role === 'admin' ? 'Remove admin' : 'Make admin'}
                  </button>
                  <button
                    class="text-label-sm text-outline transition-colors hover:text-error"
                    data-confirm={`Remove ${member.displayName}? Their waffles stay.`}
                    name="intent"
                    type="submit"
                    value="remove"
                  >
                    Remove
                  </button>
                </form>
              )}
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  {
    isAdmin && (
      <form class="mt-space-lg space-y-space-md" method="post">
        <input name="intent" type="hidden" value="group" />
        <h2 class={heading}>Group</h2>
        <label class="block">
          <span class="text-label-sm text-on-surface-variant">Name</span>
          <input class={field} name="name" required type="text" value={current.name} />
        </label>

        <label class="flex items-center gap-space-sm">
          <input
            checked={current.remindersEnabled}
            class="h-4 w-4 accent-primary"
            name="reminders_enabled"
            type="checkbox"
          />
          <span class="text-body-md text-on-surface">Reminder emails</span>
        </label>

        <div class="grid grid-cols-2 gap-space-sm">
          <label class="block">
            <span class="text-label-sm text-on-surface-variant">Morning</span>
            <input class={field} name="morning_reminder_at" type="time" value={current.morningReminderAt.slice(0, 5)} />
          </label>
          <label class="block">
            <span class="text-label-sm text-on-surface-variant">Evening</span>
            <input class={field} name="evening_reminder_at" type="time" value={current.eveningReminderAt.slice(0, 5)} />
          </label>
        </div>

        <label class="block">
          <span class="text-label-sm text-on-surface-variant">Sent to</span>
          <select class={field} name="reminder_recipients">
            <option selected={current.reminderRecipients === 'admins'} value="admins">Admins</option>
            <option selected={current.reminderRecipients === 'everyone'} value="everyone">Everyone</option>
          </select>
        </label>

        <button
          class="w-full rounded-lg bg-primary px-space-md py-space-sm text-label-md text-on-primary"
          type="submit"
        >
          Save
        </button>
      </form>
    )
  }

  <section class="mt-space-xl flex flex-wrap items-center gap-x-space-lg gap-y-space-sm border-t border-outline-variant/30 pt-space-md">
    <a class={quiet} href={`/password?next=${encodeURIComponent(`/g/${current.slug}/settings`)}`}>Change password</a>
    <a class={quiet} href="/logout">Sign out</a>
    <form method="post">
      <button
        class="text-label-sm text-outline transition-colors hover:text-error"
        data-confirm={`Leave ${current.name}? Your waffles stay yours.`}
        name="intent"
        type="submit"
        value="leave"
      >
        Leave group
      </button>
    </form>
  </section>
</App>

<script>
  // The irreversible-feeling buttons ask first.
  document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((button) => {
    button.addEventListener('click', (event) => {
      if (!confirm(button.dataset.confirm)) event.preventDefault();
    });
  });

  // On a phone, the share sheet goes straight to the group chat; elsewhere, copy.
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const input = document.getElementById('invite-url') as HTMLInputElement | null;
  if (shareButton && input) {
    const label = shareButton.querySelector<HTMLElement>('[data-share-label]')!;
    const canShare = typeof navigator.share === 'function';
    if (canShare) label.textContent = 'Share link';
    shareButton.addEventListener('click', async () => {
      try {
        if (canShare) {
          await navigator.share({ url: input.value });
          return;
        }
        await navigator.clipboard.writeText(input.value);
        label.textContent = 'Copied';
      } catch {
        input.select();
      }
    });
  }
</script>
