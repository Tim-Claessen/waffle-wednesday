---
/**
 * Setting a password.
 *
 * Where an invited member lands from their first sign-in link, and where the "email me a
 * link" recovery path ends up. Signed in by then, so this is a plain update of their own
 * account. Skippable: a sign-in link works every time, it's just slower.
 */
import Base from '../layouts/Base.astro';

const { supabase, user } = Astro.locals;

const rawNext = Astro.url.searchParams.get('next') ?? '/';
// Only ever a path on this site.
const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/';

let problem: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');

  if (password.length < 8) {
    problem = 'At least eight characters.';
  } else {
    const { error } = await supabase.auth.updateUser({ password });
    if (error) problem = "That didn't save. Try another.";
    else return Astro.redirect(next, 303);
  }
}
---

<Base title="Password">
  <main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center px-margin-sm">
    <h1 class="text-center font-serif text-headline text-on-surface">Set a password</h1>

    <form class="mt-space-lg space-y-space-md" method="post">
      {problem && (
        <p
          class="rounded-lg border border-error/40 bg-error-container/20 p-space-sm text-body-sm text-on-error-container"
          role="alert"
        >
          {problem}
        </p>
      )}
      {/* For the password manager, so it saves against the right account. */}
      <input autocomplete="username" hidden name="username" readonly type="email" value={user!.email} />
      <input
        aria-label="New password"
        autocomplete="new-password"
        class="w-full rounded-lg bg-surface-container-low px-space-md py-space-sm text-body-md text-on-surface ghost-border focus:outline-none"
        minlength="8"
        name="password"
        required
        type="password"
      />
      <button
        class="w-full rounded-lg bg-primary px-space-md py-space-md text-label-md text-on-primary shadow-ember"
        type="submit"
      >
        Save
      </button>
      <a class="block text-center text-label-sm text-outline hover:text-primary" href={next}>Skip</a>
    </form>
  </main>
</Base>
