{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "waffle-wednesday-reminders",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"observability": { "enabled": true },

	// ON HOLD (2026-10-21): no schedule, so no reminders and nothing keeping Supabase awake.
	// An empty list removes the trigger on deploy; leaving the key out would keep the old one.
	// To resume, put back ["*/30 * * * *"]: every thirty minutes, and the app decides whether
	// anything is due from each group's own reminder times, so a time change never needs a
	// deploy of this.
	"triggers": {
		"crons": []
	},

	"vars": {
		// The deployed app's origin, no trailing slash.
		"APP_URL": "https://waffle.timclaessen.com"
	}
	// CRON_SECRET is a secret: `wrangler secret put CRON_SECRET` in this directory, and the
	// same value on the app Worker.
}
